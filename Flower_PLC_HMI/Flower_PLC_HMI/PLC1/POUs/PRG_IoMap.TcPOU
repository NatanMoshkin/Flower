<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_IoMap" Id="{d3ccb63a-105a-48ed-83cb-e0b3577518bb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_IoMap
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ReadInputs();
WriteOutputs();

]]></ST>
    </Implementation>
    <Action Name="ReadInputs" Id="{f82895bb-0ca3-4c7d-b548-b9f92e196159}">
      <Implementation>
        <ST><![CDATA[(* ==========================================
   READ INPUTS — copy raw GVL_IO.dIn[] channels into named GVL_App aliases.
   Each SOL-Spring actuator has both a Retracted and an Extended proximity
   switch (spring retracts, coil extends; both end positions get sensors).
   DI layout:
     dIn[1..2]   = SepSol1 (Retract, Extend)
     dIn[3..4]   = SepSol2 (Retract, Extend)
     dIn[5..6]   = SepSol3 (Retract, Extend)
     dIn[7..8]   = PushSol1 (Retract, Extend)
     dIn[9..10]  = PushSol2 (Retract, Extend)
     dIn[11..12] = PushSol3 (Retract, Extend)
     dIn[13]     = free (was Robot STAND_SEQ_DO; retired, comms are TCP-only)
     dIn[14..15] = GripSolL (Retract, Extend)
     dIn[16..17] = GripSolR (Retract, Extend)
     dIn[18]     = PlateSenL (plate-presence, left)
     dIn[19]     = PlateSenR (plate-presence, right)
     dIn[20]     = PB1 (grip in Manual / cycle-start bypass in Auto)
     dIn[21]     = PB2 (Sep jog in Manual)
     dIn[22]     = PB3 (Push jog in Manual)
     dIn[23..24] = free
   ========================================== *)
GVL_App.bSensorSepRetracted1  := GVL_IO.dIn[1];
GVL_App.bSensorSepExtended1   := GVL_IO.dIn[2];
GVL_App.bSensorSepRetracted2  := GVL_IO.dIn[3];
GVL_App.bSensorSepExtended2   := GVL_IO.dIn[4];
GVL_App.bSensorSepRetracted3  := GVL_IO.dIn[5];
GVL_App.bSensorSepExtended3   := GVL_IO.dIn[6];
GVL_App.bSensorPushRetracted1 := GVL_IO.dIn[7];
GVL_App.bSensorPushExtended1  := GVL_IO.dIn[8];
GVL_App.bSensorPushRetracted2 := GVL_IO.dIn[9];
GVL_App.bSensorPushExtended2  := GVL_IO.dIn[10];
GVL_App.bSensorPushRetracted3 := GVL_IO.dIn[11];
GVL_App.bSensorPushExtended3  := GVL_IO.dIn[12];

(* Grip pistons — DI 14..17. *)
GVL_App.bSensorGripRetractedL := GVL_IO.dIn[14];
GVL_App.bSensorGripExtendedL  := GVL_IO.dIn[15];
GVL_App.bSensorGripRetractedR := GVL_IO.dIn[16];
GVL_App.bSensorGripExtendedR  := GVL_IO.dIn[17];

(* Plate-presence sensors — DI 18..19. Both must be TRUE for WAIT_PLATE to
   advance the cycle into GRIP_EXTENDING. *)
GVL_App.bPlateSenL := GVL_IO.dIn[18];
GVL_App.bPlateSenR := GVL_IO.dIn[19];

(* Panel push buttons — DI 20..22. Consumer logic lives in MAIN (mode-gated
   jog OR cycle-start bypass). *)
GVL_App.bPb1 := GVL_IO.dIn[20];
GVL_App.bPb2 := GVL_IO.dIn[21];
GVL_App.bPb3 := GVL_IO.dIn[22];]]></ST>
      </Implementation>
    </Action>
    <Action Name="WriteOutputs" Id="{d4911134-0871-485c-a76f-89221ed9b4ed}">
      <Implementation>
        <ST><![CDATA[(* ==========================================
   WRITE OUTPUTS — copy named GVL_App aliases into raw GVL_IO.dOut[] channels.
   Single Extend coil per actuator (SOL-Spring, spring retracts).
   DO layout:
     dOut[1..3]   = SepSol1..3 Extend coils
     dOut[4..6]   = PushSol1..3 Extend coils
     dOut[7]      = free (was PLC -> Robot STAND_SEQ_DI; retired, comms are TCP-only)
     dOut[8]      = GripSolL Extend coil
     dOut[9]      = GripSolR Extend coil
     dOut[10]     = LED1 (mirrors PB1)
     dOut[11]     = LED2 (mirrors PB2)
     dOut[12]     = LED3 (mirrors PB3)
     dOut[13..16] = free
   ========================================== *)
GVL_IO.dOut[1] := GVL_App.bValveSepExtend1;
GVL_IO.dOut[2] := GVL_App.bValveSepExtend2;
GVL_IO.dOut[3] := GVL_App.bValveSepExtend3;
GVL_IO.dOut[4] := GVL_App.bValvePushExtend1;
GVL_IO.dOut[5] := GVL_App.bValvePushExtend2;
GVL_IO.dOut[6] := GVL_App.bValvePushExtend3;

(* Grip piston extend coils. *)
GVL_IO.dOut[8] := GVL_App.bValveGripExtendL;
GVL_IO.dOut[9] := GVL_App.bValveGripExtendR;

(* Panel push-button status LEDs — mirror driven by MAIN. *)
GVL_IO.dOut[10] := GVL_App.bLedPb1;
GVL_IO.dOut[11] := GVL_App.bLedPb2;
GVL_IO.dOut[12] := GVL_App.bLedPb3;
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>