<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_RobotTcpClient" Id="{9a819722-65ef-4bb0-a58a-040059e1d2fe}" SpecialFunc="None">
    <Declaration><![CDATA[(*
   TCP/IP client for the Dobot protocol on port 6001. Robot is the TCP
   server; PLC dials in. Robot comms are TCP-ONLY: the former discrete-I/O
   handshake (STAND_SEQ_DO / STAND_SEQ_DI) is retired and its channels
   (DI[13], DO[7]) are now free. Uses the free-with-TF6310 Tc2_TcpIp
   socket FBs; empty sSrvNetId targets the local TwinCAT TCP/IP Connection
   Server.

   Protocol (raw ASCII, no newline framing; one send -> one reply, matching
   RobotBridge\Client_working_example\tcp client.py / dummy_server.py):
     PLC -> robot        robot -> PLC
     "GET_SYNC"          "SYNC:J_SPEED=10,L_SPEED=10,..."
     "NAME:VALUE"        "OK: SET NAME"
     "New_Bulb:1"        "OK: SET New_Bulb"
     "STATE:n"           "CMD:m"

   STATE frames are the PLC's continuous state push (n = INT value of
   E_MasterAutoStep, or MANUAL=30 when bAutoMode=FALSE). Sent on every
   change of stParams.nStateOut and every IDLE_STATE_MS as keep-alive.
   The robot's reply carries the next command (m in {0,1,2}: 0=none,
   1=start cycle, 2=reset error) which is written to stParams.nRobotCmd
   for MAIN to R_TRIG.

   Tuning params are bidirectional. GET_SYNC pulls all 11 into stParams
   after every connect, and the FB then snapshots them into aShadow. Any
   later divergence between a live field and its shadow slot is treated as
   an operator edit and pushed back as NAME:VALUE, one param per
   round-trip. So an HMI NumericInput can bind straight to
   GVL_Robot.stParams.J_SPEED and simply work -- no request flags to set.
   The bSetParam / sSetName / nSetVal triple remains as a raw escape hatch
   for names that are not struct fields.

   Known limitation: stParams is both setpoint and actual. An edit made
   while the link is down is overwritten by the GET_SYNC that follows the
   next reconnect. Separating desired-vs-actual would need a second struct.

   State machine mirrors the Python supervisor: Disconnected -> Connecting
   -> Connected; any socket error closes and re-dials after RECONNECT_MS.
*)
FUNCTION_BLOCK FB_RobotTcpClient
VAR_INPUT
    // Master enable. FALSE tears down any connection and holds Disconnected.
    bEnable     : BOOL;
    // Robot server target (from GVL_Robot.sRobotHost / nRobotPort).
    sRemoteHost : STRING;
    nRemotePort : UINT;
END_VAR
VAR_IN_OUT
    // Status mirror for the HMI (eConnState, packet counts, last messages).
    stRobot  : ST_HmiRobot;
    // Tuning params + request flags; SYNC replies parse back into this.
    stParams : ST_RobotParams;
END_VAR
VAR
    fbConnect : FB_SocketConnect;
    fbClose   : FB_SocketClose;
    fbSend    : FB_SocketSend;
    fbReceive : FB_SocketReceive;
    hSocket   : T_HSOCKET;

    // Empty => local TwinCAT TCP/IP Connection Server (TF6310).
    sSrvNetId : T_AmsNetId := '';

    eState : E_RobotConnState := E_RobotConnState.Disconnected;
    iIo    : INT;            // request/reply sub-state while Connected
    iPend  : INT;            // which message we last sent (drives reply parse)

    tonReconnect : TON;      // delay before re-dial after a drop
    tonIdle      : TON;      // idle -> STATE keep-alive
    tonReply     : TON;      // reply timeout guard

    sTxMsg    : STRING(255);
    sRxMsg    : STRING(255);
    aRxBuffer : ARRAY[0..255] OF BYTE;

    bAutoSyncQueued : BOOL;  // one-shot GET_SYNC right after each (re)connect
    nLastStateSent  : INT := -1;   // last nStateOut we transmitted; -1 forces first push

    // Shadow copy of the 11 tuning params, used to detect operator edits.
    // Snapshotted from stParams after every GET_SYNC round-trip; any later
    // divergence means "the HMI changed this field" and is pushed to the
    // robot as NAME:VALUE. Held invalid until the first SYNC completes so
    // the power-on defaults are never mistaken for edits.
    aShadow      : ARRAY[1..11] OF INT;
    bShadowValid : BOOL;

    // Which param the in-flight TX_SETPARAM belongs to. 0 = the explicit
    // bSetParam/sSetName/nSetVal escape hatch (no shadow slot to update).
    nPendIdx : INT;
    nPendVal : INT;   // value actually sent; written to aShadow on ACK
END_VAR
VAR
    // Endpoint actually dialled for the live session. sRemoteHost is only
    // read at connect time, so without this a commissioner who edits the IP
    // on the Robot page sees nothing happen until the socket happens to
    // drop -- the field would look broken.
    sDialledHost  : STRING;
    nDialledPort  : UINT;
    bDialledValid : BOOL;
END_VAR
VAR CONSTANT
    IO_IDLE      : INT := 0;
    IO_WAIT_SEND : INT := 1;
    IO_WAIT_RECV : INT := 2;

    PARAM_COUNT  : INT := 11;   // must match ST_RobotParams / SYNC_ORDER

    TX_NONE     : INT := 0;
    TX_GETSYNC  : INT := 1;
    TX_SETPARAM : INT := 2;
    TX_NEWBULB  : INT := 3;
    TX_STATE    : INT := 4;

    RECONNECT_MS   : TIME := T#3S;
    IDLE_STATE_MS  : TIME := T#1S;   // keep-alive STATE push cadence
    REPLY_TO_MS    : TIME := T#2S;
    CONNECT_TO_MS  : TIME := T#2S;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Disable request routes an active session through the Error/close path.
IF NOT bEnable AND (eState = E_RobotConnState.Connecting OR eState = E_RobotConnState.Connected) THEN
    eState := E_RobotConnState.Error;
END_IF

// Endpoint retarget. The connect call reads sRemoteHost once, so a live
// session has to be torn down for a new IP to be dialled. Routed through
// Error, the same close-and-retry path the disable request uses, so the
// socket is released properly rather than leaked.
// Baselined on the first scan: without the guard the initial transition
// from an empty shadow would look like an edit and force a pointless
// reconnect at startup.
IF NOT bDialledValid THEN
    bDialledValid := TRUE;
    sDialledHost  := sRemoteHost;
    nDialledPort  := nRemotePort;
ELSIF (sRemoteHost <> sDialledHost) OR (nRemotePort <> nDialledPort) THEN
    sDialledHost := sRemoteHost;
    nDialledPort := nRemotePort;
    IF eState = E_RobotConnState.Connecting OR eState = E_RobotConnState.Connected THEN
        eState := E_RobotConnState.Error;
    END_IF
END_IF

CASE eState OF

E_RobotConnState.Disconnected:
    tonReconnect(IN := TRUE, PT := RECONNECT_MS);
    IF bEnable AND tonReconnect.Q THEN
        tonReconnect(IN := FALSE);
        fbConnect(bExecute := FALSE);
        eState := E_RobotConnState.Connecting;
    END_IF

E_RobotConnState.Connecting:
    fbConnect(
        sSrvNetId   := sSrvNetId,
        sRemoteHost := sRemoteHost,
        nRemotePort := nRemotePort,
        bExecute    := TRUE,
        tTimeout    := CONNECT_TO_MS);
    IF NOT fbConnect.bBusy THEN
        fbConnect(bExecute := FALSE);
        IF fbConnect.bError THEN
            eState := E_RobotConnState.Error;
        ELSE
            hSocket         := fbConnect.hSocket;
            iIo             := IO_IDLE;
            iPend           := TX_NONE;
            nPendIdx        := 0;
            bAutoSyncQueued := TRUE;   // pull current params right after connect
            bShadowValid    := FALSE;  // no edit detection until that SYNC lands
            nLastStateSent  := -1;     // force initial STATE push
            tonIdle(IN := FALSE);
            eState := E_RobotConnState.Connected;
        END_IF
    END_IF

E_RobotConnState.Connected:
    ConnectedIo();

E_RobotConnState.Error:
    fbClose(
        sSrvNetId := sSrvNetId,
        hSocket   := hSocket,
        bExecute  := TRUE,
        tTimeout  := CONNECT_TO_MS);
    IF NOT fbClose.bBusy THEN
        fbClose(bExecute := FALSE);
        MEMSET(ADR(hSocket), 0, SIZEOF(hSocket));
        iIo   := IO_IDLE;
        iPend := TX_NONE;
        tonReconnect(IN := FALSE);
        eState := E_RobotConnState.Disconnected;
    END_IF

END_CASE

// Mirror connection state to the HMI status struct.
stRobot.eConnState     := eState;
stRobot.sConnStateText := TO_STRING(eState);
]]></ST>
    </Implementation>
    <Method Name="ConnectedIo" Id="{47746f7b-ae67-4576-93f9-16e10d7f2768}">
      <Declaration><![CDATA[// Request/reply sequencer, run while eState = Connected.
METHOD ConnectedIo : BOOL
VAR
    nChanged : INT;   // index of first param edited by the HMI, 0 = none
    nIdx     : INT;   // param index behind an explicit bSetParam name
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE iIo OF

IO_IDLE:
    tonIdle(IN := TRUE, PT := IDLE_STATE_MS);

    // Detect an operator edit: any of the 11 params differing from the
    // shadow snapshot taken after the last SYNC. Suppressed until the
    // first SYNC validates the shadow, otherwise the compiled-in defaults
    // would all look like edits on the very first scan after connect.
    IF bShadowValid THEN
        nChanged := FindChangedParam();
    ELSE
        nChanged := 0;
    END_IF

    // Priority order.
    //  1. The post-connect one-shot GET_SYNC, before anything else: the
    //     reply to a STATE push can carry CMD:1, and starting a cycle on
    //     parameters we have not read back yet would run the robot on
    //     stale values.
    //  2. A CHANGED state. CMD frames ride back on STATE replies, so
    //     delaying a state push behind a burst of parameter writes would
    //     also delay start/reset commands from the robot.
    //  3. Explicit requests, then detected edits.
    //  4. The keep-alive push last, where it only fires on an idle link.
    IF bAutoSyncQueued THEN
        bAutoSyncQueued := FALSE;
        sTxMsg := 'GET_SYNC';
        iPend  := TX_GETSYNC;
        StartSend();
    ELSIF stParams.nStateOut <> nLastStateSent THEN
        SendState();
    ELSIF stParams.bSetParam THEN
        // Explicit escape hatch: caller supplies the raw name/value pair.
        // Clamp it too, and write the clamped value back so the caller can
        // see what was actually sent. Unknown names pass through untouched --
        // that is the point of the escape hatch.
        nIdx := ParamIndex(stParams.sSetName);
        IF nIdx > 0 THEN
            stParams.nSetVal := ClampParam(i := nIdx, nVal := stParams.nSetVal);
        END_IF
        sTxMsg   := CONCAT(CONCAT(stParams.sSetName, ':'), INT_TO_STRING(stParams.nSetVal));
        iPend    := TX_SETPARAM;
        nPendIdx := 0;
        StartSend();
    ELSIF stParams.bTriggerNewBulb THEN
        sTxMsg := 'New_Bulb:1';
        iPend  := TX_NEWBULB;
        StartSend();
    ELSIF stParams.bGetSync THEN
        sTxMsg := 'GET_SYNC';
        iPend  := TX_GETSYNC;
        StartSend();
    ELSIF nChanged > 0 THEN
        // One param per round-trip; the next idle scan picks up the rest.
        //
        // Clamp, and write the clamped value BACK into the field before
        // sending. Writing back is not cosmetic: the shadow is updated to
        // the value we sent, so if the field kept the operator's
        // out-of-range number it would differ from the shadow forever and
        // the FB would re-send on every idle scan. Writing back converges,
        // and the HMI then shows what the robot actually got.
        nPendIdx := nChanged;
        nPendVal := ClampParam(i := nChanged, nVal := ParamValue(nChanged));
        SetParamValue(i := nChanged, nVal := nPendVal);
        sTxMsg   := CONCAT(CONCAT(ParamName(nChanged), ':'), INT_TO_STRING(nPendVal));
        iPend    := TX_SETPARAM;
        StartSend();
    ELSIF tonIdle.Q THEN
        SendState();
    END_IF

IO_WAIT_SEND:
    fbSend(
        sSrvNetId := sSrvNetId,
        hSocket   := hSocket,
        cbLen     := TO_UDINT(LEN(sTxMsg)),
        pSrc      := ADR(sTxMsg),
        bExecute  := TRUE,
        tTimeout  := REPLY_TO_MS);
    IF NOT fbSend.bBusy THEN
        fbSend(bExecute := FALSE);
        IF fbSend.bError THEN
            eState := E_RobotConnState.Error;
        ELSE
            stRobot.nPacketsTx     := stRobot.nPacketsTx + 1;
            stRobot.sLastTxMessage := sTxMsg;
            tonReply(IN := FALSE);
            iIo := IO_WAIT_RECV;
        END_IF
    END_IF

IO_WAIT_RECV:
    tonReply(IN := TRUE, PT := REPLY_TO_MS);
    fbReceive(
        sSrvNetId := sSrvNetId,
        hSocket   := hSocket,
        cbLen     := SIZEOF(aRxBuffer) - 1,
        pDest     := ADR(aRxBuffer),
        bExecute  := TRUE,
        tTimeout  := REPLY_TO_MS);
    IF NOT fbReceive.bBusy THEN
        fbReceive(bExecute := FALSE);
        IF fbReceive.bError THEN
            eState := E_RobotConnState.Error;
        ELSIF fbReceive.nRecBytes > 0 THEN
            aRxBuffer[fbReceive.nRecBytes] := 0;   // null-terminate
            MEMCPY(ADR(sRxMsg), ADR(aRxBuffer), fbReceive.nRecBytes + 1);
            tonReply(IN := FALSE);
            HandleReply();
            iIo := IO_IDLE;
        ELSIF tonReply.Q THEN
            // No reply in time. STATE may go unanswered occasionally --
            // tolerate it (we'll try again next keep-alive); everything
            // else is a real fault -> drop and reconnect.
            tonReply(IN := FALSE);
            IF iPend = TX_STATE THEN
                iPend := TX_NONE;
                iIo   := IO_IDLE;
            ELSE
                eState := E_RobotConnState.Error;
            END_IF
        END_IF
    END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendState" Id="{b1c4d2e0-3f7a-4c18-9d55-7e2a6b0f4c31}">
      <Declaration><![CDATA[// Arm a STATE:n push and remember what we sent.
METHOD SendState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sTxMsg         := CONCAT('STATE:', INT_TO_STRING(stParams.nStateOut));
nLastStateSent := stParams.nStateOut;
iPend          := TX_STATE;
nPendIdx       := 0;
StartSend();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindChangedParam" Id="{c2d5e3f1-4a8b-4d29-8e66-8f3b7c1a5d42}">
      <Declaration><![CDATA[// Index of the first param whose live value differs from the shadow
// snapshot, or 0 when everything matches.
METHOD FindChangedParam : INT
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindChangedParam := 0;

FOR i := 1 TO PARAM_COUNT DO
    IF ParamValue(i) <> aShadow[i] THEN
        FindChangedParam := i;
        RETURN;
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetShadowAll" Id="{d3e6f402-5b9c-4e3a-9f77-9a4c8d2b6e53}">
      <Declaration><![CDATA[// Re-baseline the shadow to the current stParams values and enable edit
// detection. Called after every GET_SYNC round-trip.
METHOD SetShadowAll : BOOL
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO PARAM_COUNT DO
    aShadow[i] := ParamValue(i);
END_FOR

bShadowValid := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParamValue" Id="{e4f70513-6cad-4f4b-8a88-ab5d9e3c7f64}">
      <Declaration><![CDATA[// Live value of param i. Index order must match ParamName and the
// robot's SYNC_ORDER.
METHOD ParamValue : INT
VAR_INPUT
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i OF
     1: ParamValue := stParams.J_SPEED;
     2: ParamValue := stParams.L_SPEED;
     3: ParamValue := stParams.REPEATS;
     4: ParamValue := stParams.START_WAIT;
     5: ParamValue := stParams.WATER_WAIT;
     6: ParamValue := stParams.STAND_WAIT;
     7: ParamValue := stParams.END_WAIT;
     8: ParamValue := stParams.WATER_SPEED;
     9: ParamValue := stParams.WAX_WAIT_TIME_IN;
    10: ParamValue := stParams.WAX_WAIT_TIME_OUT;
    11: ParamValue := stParams.WAX_SPEED;
ELSE
    ParamValue := 0;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetParamValue" Id="{1a2b3c4d-5e6f-4708-8192-a3b4c5d6e7f8}">
      <Declaration><![CDATA[// Write a value into param i. Inverse of ParamValue; same index order.
METHOD SetParamValue : BOOL
VAR_INPUT
    i    : INT;
    nVal : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i OF
     1: stParams.J_SPEED           := nVal;
     2: stParams.L_SPEED           := nVal;
     3: stParams.REPEATS           := nVal;
     4: stParams.START_WAIT        := nVal;
     5: stParams.WATER_WAIT        := nVal;
     6: stParams.STAND_WAIT        := nVal;
     7: stParams.END_WAIT          := nVal;
     8: stParams.WATER_SPEED       := nVal;
     9: stParams.WAX_WAIT_TIME_IN  := nVal;
    10: stParams.WAX_WAIT_TIME_OUT := nVal;
    11: stParams.WAX_SPEED         := nVal;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParamIndex" Id="{2b3c4d5e-6f70-4819-92a3-b4c5d6e7f809}">
      <Declaration><![CDATA[// Index of a param by its wire name, or 0 if the name is not one of the
// eleven. Used to clamp the explicit bSetParam escape hatch; an unknown
// name deliberately returns 0 and is passed through unclamped.
METHOD ParamIndex : INT
VAR_INPUT
    sName : STRING(30);
END_VAR
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ParamIndex := 0;

FOR i := 1 TO PARAM_COUNT DO
    IF ParamName(i) = sName THEN
        ParamIndex := i;
        RETURN;
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClampParam" Id="{3c4d5e6f-7081-492a-a3b4-c5d6e7f8091a}">
      <Declaration><![CDATA[(*
   Bound one parameter to the robot's documented range.

   These limits are the vendor's own: the Dobot-side tuning GUI
   (Robot\167-01-Saad\tcp client.py, PARAMS table + its clamp) refuses
   anything outside them, and readme.txt mirrors the same table. The robot's
   Lua (src2.lua) does NOT validate -- it assigns tonumber() straight
   through -- so nothing downstream of us catches a bad value.

   Clamping here rather than only on the VISU NumericInputs is deliberate:
   a per-control min/max bounds only that control, while every writer
   (panel, FlowerPyHmi over ADS, any future ADS client, and the bSetParam
   escape hatch) funnels through this FB.

   Units are percentages for the four speed values -- global.lua Init()
   passes J_SPEED / L_SPEED to VelJ() / VelL() and the WAX / WATER speeds to
   the v= velocity-ratio option of MovL. The waits are milliseconds.
*)
METHOD ClampParam : INT
VAR_INPUT
    i    : INT;
    nVal : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ClampParam := LIMIT(ParamMin(i), nVal, ParamMax(i));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParamMin" Id="{4d5e6f70-8192-4a3b-b4c5-d6e7f8091a2b}">
      <Declaration><![CDATA[// Lower bound of param i. Same index order as ParamValue / ParamName.
METHOD ParamMin : INT
VAR_INPUT
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i OF
     1: ParamMin :=  1;    // J_SPEED            %
     2: ParamMin :=  1;    // L_SPEED            %
     3: ParamMin :=  1;    // REPEATS
     4: ParamMin := 10;    // START_WAIT         ms
     5: ParamMin := 10;    // WATER_WAIT         ms
     6: ParamMin := 10;    // STAND_WAIT         ms
     7: ParamMin := 10;    // END_WAIT           ms
     8: ParamMin :=  0;    // WATER_SPEED        %
     9: ParamMin :=  0;    // WAX_WAIT_TIME_IN   ms
    10: ParamMin := 10;    // WAX_WAIT_TIME_OUT  ms
    11: ParamMin :=  0;    // WAX_SPEED          %
ELSE
    ParamMin := 0;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParamMax" Id="{5e6f7081-92a3-4b4c-85d6-e7f8091a2b3c}">
      <Declaration><![CDATA[// Upper bound of param i. Same index order as ParamValue / ParamName.
METHOD ParamMax : INT
VAR_INPUT
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i OF
     1: ParamMax :=   100;   // J_SPEED
     2: ParamMax :=   100;   // L_SPEED
     3: ParamMax :=    10;   // REPEATS
     4: ParamMax := 10000;   // START_WAIT
     5: ParamMax := 10000;   // WATER_WAIT
     6: ParamMax := 10000;   // STAND_WAIT
     7: ParamMax := 10000;   // END_WAIT
     8: ParamMax :=   100;   // WATER_SPEED
     9: ParamMax := 10000;   // WAX_WAIT_TIME_IN
    10: ParamMax := 10000;   // WAX_WAIT_TIME_OUT
    11: ParamMax :=   100;   // WAX_SPEED
ELSE
    ParamMax := 32767;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParamName" Id="{f5081624-7dbe-405c-9b99-bc6eaf4d8075}">
      <Declaration><![CDATA[// Wire name of param i, as the robot expects it in NAME:VALUE.
METHOD ParamName : STRING(30)
VAR_INPUT
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i OF
     1: ParamName := 'J_SPEED';
     2: ParamName := 'L_SPEED';
     3: ParamName := 'REPEATS';
     4: ParamName := 'START_WAIT';
     5: ParamName := 'WATER_WAIT';
     6: ParamName := 'STAND_WAIT';
     7: ParamName := 'END_WAIT';
     8: ParamName := 'WATER_SPEED';
     9: ParamName := 'WAX_WAIT_TIME_IN';
    10: ParamName := 'WAX_WAIT_TIME_OUT';
    11: ParamName := 'WAX_SPEED';
ELSE
    ParamName := '';
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartSend" Id="{aaa8f8f6-1eec-428e-a921-2ce64744b1fb}">
      <Declaration><![CDATA[// Arm a send: reset edges/timers and enter the send wait state.
METHOD StartSend : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonIdle(IN := FALSE);
fbSend(bExecute := FALSE);
iIo := IO_WAIT_SEND;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HandleReply" Id="{57d85451-0daa-42a3-9e5e-dc41761a4754}">
      <Declaration><![CDATA[// Dispatch on what we last sent; clear the consumed request flag.
METHOD HandleReply : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stRobot.nPacketsRx   := stRobot.nPacketsRx + 1;
stRobot.sLastMessage := sRxMsg;

// Any reply may embed the next robot command as "CMD:n". Parse it
// regardless of iPend so the state-push round-trip carries commands.
IF FIND(sRxMsg, 'CMD:') = 1 AND LEN(sRxMsg) > 4 THEN
    stParams.nRobotCmd := STRING_TO_INT(MID(sRxMsg, LEN(sRxMsg) - 4, 5));
END_IF

CASE iPend OF
    TX_GETSYNC:
        IF FIND(sRxMsg, 'SYNC:') = 1 THEN
            ParseSync();
        END_IF
        // Re-baseline unconditionally, even if the reply was malformed and
        // ParseSync did nothing. The shadow then equals whatever stParams
        // currently holds, so a pull never echoes straight back out as 11
        // spurious writes -- and the edit detector becomes live either way
        // instead of staying disabled behind one bad frame.
        SetShadowAll();
        stParams.bGetSync := FALSE;
    TX_SETPARAM:
        // Bank the value we actually sent, not the current field value: if
        // the operator edited the same param again mid-round-trip, the
        // mismatch survives and gets re-sent on the next idle scan.
        IF nPendIdx > 0 THEN
            aShadow[nPendIdx] := nPendVal;
            nPendIdx := 0;
        ELSE
            stParams.bSetParam := FALSE;
        END_IF
    TX_NEWBULB:
        stParams.bTriggerNewBulb := FALSE;
    TX_STATE:
        // CMD parsing already handled above; no flag to clear.
        ;
END_CASE

iPend := TX_NONE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseSync" Id="{4f452784-bcac-458f-94dd-1896402f6324}">
      <Declaration><![CDATA[// Parse "SYNC:NAME=VALUE,NAME=VALUE,..." into stParams.
METHOD ParseSync : BOOL
VAR
    sRest  : STRING(255);
    sToken : STRING(60);
    sName  : STRING(30);
    sVal   : STRING(20);
    nComma : INT;
    nEq    : INT;
    nLen   : INT;
    nGuard : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nLen := LEN(sRxMsg);
IF nLen <= 5 THEN
    RETURN;
END_IF

// Strip the leading "SYNC:" (5 chars).
sRest := MID(sRxMsg, nLen - 5, 6);

nGuard := 0;
WHILE LEN(sRest) > 0 AND nGuard < 32 DO
    nGuard := nGuard + 1;

    nComma := FIND(sRest, ',');
    IF nComma > 0 THEN
        sToken := LEFT(sRest, nComma - 1);
        sRest  := MID(sRest, LEN(sRest) - nComma, nComma + 1);
    ELSE
        sToken := sRest;
        sRest  := '';
    END_IF

    nEq := FIND(sToken, '=');
    IF nEq > 0 THEN
        sName := LEFT(sToken, nEq - 1);
        sVal  := MID(sToken, LEN(sToken) - nEq, nEq + 1);
        ApplyParam(sName := sName, nVal := STRING_TO_INT(sVal));
    END_IF
END_WHILE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ApplyParam" Id="{540317ec-41e2-47bc-b64b-681858e2c1d4}">
      <Declaration><![CDATA[// Assign one parsed NAME=VALUE pair into stParams.
METHOD ApplyParam : BOOL
VAR_INPUT
    sName : STRING(30);
    nVal  : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF    sName = 'J_SPEED'           THEN stParams.J_SPEED           := nVal;
ELSIF sName = 'L_SPEED'           THEN stParams.L_SPEED           := nVal;
ELSIF sName = 'REPEATS'           THEN stParams.REPEATS           := nVal;
ELSIF sName = 'START_WAIT'        THEN stParams.START_WAIT        := nVal;
ELSIF sName = 'WATER_WAIT'        THEN stParams.WATER_WAIT        := nVal;
ELSIF sName = 'STAND_WAIT'        THEN stParams.STAND_WAIT        := nVal;
ELSIF sName = 'END_WAIT'          THEN stParams.END_WAIT          := nVal;
ELSIF sName = 'WATER_SPEED'       THEN stParams.WATER_SPEED       := nVal;
ELSIF sName = 'WAX_WAIT_TIME_IN'  THEN stParams.WAX_WAIT_TIME_IN  := nVal;
ELSIF sName = 'WAX_WAIT_TIME_OUT' THEN stParams.WAX_WAIT_TIME_OUT := nVal;
ELSIF sName = 'WAX_SPEED'         THEN stParams.WAX_SPEED         := nVal;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
