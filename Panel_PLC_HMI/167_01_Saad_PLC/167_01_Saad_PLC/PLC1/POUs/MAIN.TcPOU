<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{14abf4a7-7840-47f5-84af-a7dedadf8c83}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbSepSol1  : FB_SolSpringPiston_2Pos;
    fbSepSol2  : FB_SolSpringPiston_2Pos;
    fbSepSol3  : FB_SolSpringPiston_2Pos;
    fbPushSol1 : FB_SolSpringPiston_2Pos;
    fbPushSol2 : FB_SolSpringPiston_2Pos;
    fbPushSol3 : FB_SolSpringPiston_2Pos;
    fbGripSolL : FB_SolSpringPiston_2Pos;
    fbGripSolR : FB_SolSpringPiston_2Pos;

    // Full-machine sequencer coordinating the 3 pairs of (SepSolN,
    // PushSolN) + the 2 grip pistons. In this panel solution the master
    // cycle is the ONLY auto driver — the per-piston auto tiles
    // (bench-only feature) are removed, so no OR-merge at the call sites.
    fbMasterAutoCycle : FB_MasterAutoCycle;

    // Robot TCP/IP client — TCP-only protocol on :6001. Carries tuning
    // params + New_Bulb + STATE/CMD (state push out, command in). The
    // former discrete-I/O handshake (STAND_SEQ_DO/DI) is retired.
    fbRobotTcp : FB_RobotTcpClient;

    // Robot TCP command channel (nRobotCmd: 0=none, 1=start cycle,
    // 2=reset error). Consumed as a LEVEL and cleared on consumption --
    // see the body for why edge-detecting it deadlocked the machine.
    // bRobotStartPulse is the resulting one-scan pulse handed to
    // fbMasterAutoCycle's bExtStartPulse.
    bRobotStartPulse : BOOL;

    // PB1 rising edge in Auto mode triggers a cycle start (bypass of the
    // robot's CMD:1). Fed into stMasterAuto.bSimStartAssembly which the FB
    // already OR-merges with the external start pulse and auto-clears.
    fbTrigPb1 : R_TRIG;

    // Scratch copies of the global machine mode, computed once per scan and
    // fanned out to all eight pistons (both eMode and bMode) just below.
    bMachineAuto : BOOL;
    bManualMode  : BOOL;   // = NOT bMachineAuto; gates PB jogs
    eMachineMode : E_ControlMode;

    // Flushes GVL_HmiPersistent to disk once the operator stops editing.
    // PERSISTENT alone never wrote anything on a power cut -- see the FB
    // header. Called last so it sees this scan's final config values.
    fbPersistentSave : FB_PersistentAutoSave;

    // Status-lamp blink source. A self-resetting TON toggling a BOOL gives a
    // 50% duty cycle; the TON on its own only produces a one-scan pulse,
    // which would make the lamp flicker rather than blink.
    tonBlink : TON;
    bBlink   : BOOL;

    // Wall clock for the log timestamps. Lives here because F_LogEvent is a
    // FUNCTION and cannot own an FB instance. dwCycle is in SECONDS.
    fbLocalTime : Tc2_Utilities.FB_LocalSystemTime;
    nLastSec    : WORD := 16#FFFF;   // impossible value, forces a first build
    sHH, sMM, sSS : STRING(2);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* ==========================================
   0. CONTINUOUS IS DISABLED ON THE REAL MACHINE
   Forced FALSE every scan, not merely cleared at boot. The production
   machine never free-runs: every cycle is started by the operator or by the
   robot's CMD:1. The checkbox was removed from AutoMain, but a VISU page is
   only one of several writers — FlowerPyHmi has its own Continuous checkbox
   on two pages and reaches the field over ADS — so the field itself has to
   be the enforcement point. Any write is overwritten within one scan.

   Why it matters that this one is airtight: FB_MasterAutoCycle's IDLE branch
   tests it as a LEVEL, not an edge:

       IF bMachineAuto AND (... OR stCfg.bContinuous) THEN

   so a TRUE here re-arms a cycle with no operator or robot involvement at
   all. It is the only start path with nothing external gating it, which is
   also why it was the one field the cold-boot block used to clear.

   bAutoMode is deliberately NOT touched (operator decision, 2026-07-27): the
   panel comes back in Automatic and IDLE after a power cycle, still needing
   a real start trigger. Consequence: in Auto it reports nStateOut = 0 (IDLE)
   rather than 30 (MANUAL), so a robot already running may request a cycle
   straight after power-up. That is the intended production behaviour.

   The timers, bNoSensors and bBypassPlateSensors are untouched too — they
   are operator config and persisting them is the point of the flush.
   ========================================== *)
GVL_HmiPersistent.stMasterAutoCfg.bContinuous := FALSE;

(* ==========================================
   0a. LOG WALL CLOCK
   Refreshes GVL_Log.sNow, which F_LogEvent stamps into every entry so the
   Logs page can show a Time column. Rebuilt only when the second actually
   rolls over — the string work is trivial but there is no reason to redo it
   100 times a second.

   bValid gates it: an unset RTC shows '--:--:--' rather than a plausible
   wrong time, which is the difference between "the clock is not set" and
   "these events happened at 00:00:03".
   ========================================== *)
fbLocalTime(bEnable := TRUE, dwCycle := 1);

IF NOT fbLocalTime.bValid THEN
    GVL_Log.sNow := '--:--:--';
ELSIF fbLocalTime.systemTime.wSecond <> nLastSec THEN
    nLastSec := fbLocalTime.systemTime.wSecond;
    // RIGHT(CONCAT('0', n), 2) is the zero-pad: '7' -> '07', '17' -> '17'.
    sHH := RIGHT(CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wHour)), 2);
    sMM := RIGHT(CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wMinute)), 2);
    sSS := RIGHT(CONCAT('0', WORD_TO_STRING(fbLocalTime.systemTime.wSecond)), 2);
    GVL_Log.sNow := CONCAT(CONCAT(CONCAT(CONCAT(sHH, ':'), sMM), ':'), sSS);
END_IF

(* ==========================================
   Master auto-cycle — coordinates the 3 pairs of (Sep,Push) pistons
   with the robot handshake. Called BEFORE the per-piston
   auto FBs and BEFORE the piston FBs so its bSepCmd* / bPushCmd*
   outputs feed forward this scan.
   Master reads bIs* from the piston stHmi structs — those carry the
   previous scan's values (100 µs lag, negligible for a physical
   machine).
   ========================================== *)
fbMasterAutoCycle.bSepIsExtended[1]   := GVL_HMI.stSepSol1.bIsExtended;
fbMasterAutoCycle.bSepIsExtended[2]   := GVL_HMI.stSepSol2.bIsExtended;
fbMasterAutoCycle.bSepIsExtended[3]   := GVL_HMI.stSepSol3.bIsExtended;
fbMasterAutoCycle.bSepIsRetracted[1]  := GVL_HMI.stSepSol1.bIsRetracted;
fbMasterAutoCycle.bSepIsRetracted[2]  := GVL_HMI.stSepSol2.bIsRetracted;
fbMasterAutoCycle.bSepIsRetracted[3]  := GVL_HMI.stSepSol3.bIsRetracted;
fbMasterAutoCycle.bPushIsExtended[1]  := GVL_HMI.stPushSol1.bIsExtended;
fbMasterAutoCycle.bPushIsExtended[2]  := GVL_HMI.stPushSol2.bIsExtended;
fbMasterAutoCycle.bPushIsExtended[3]  := GVL_HMI.stPushSol3.bIsExtended;
fbMasterAutoCycle.bPushIsRetracted[1] := GVL_HMI.stPushSol1.bIsRetracted;
fbMasterAutoCycle.bPushIsRetracted[2] := GVL_HMI.stPushSol2.bIsRetracted;
fbMasterAutoCycle.bPushIsRetracted[3] := GVL_HMI.stPushSol3.bIsRetracted;

(* Grip pistons — L=[1], R=[2]. *)
fbMasterAutoCycle.bGripIsExtended[1]  := GVL_HMI.stGripSolL.bIsExtended;
fbMasterAutoCycle.bGripIsExtended[2]  := GVL_HMI.stGripSolR.bIsExtended;
fbMasterAutoCycle.bGripIsRetracted[1] := GVL_HMI.stGripSolL.bIsRetracted;
fbMasterAutoCycle.bGripIsRetracted[2] := GVL_HMI.stGripSolR.bIsRetracted;

(* Plate-presence sensors gate the cycle at WAIT_PLATE. Wire the raw
   GVL_App copies straight into the master cycle. Also mirror them onto
   GVL_HMI so the classic VISU / web HMI indicator lamps can bind. *)
fbMasterAutoCycle.bPlateSenL := GVL_App.bPlateSenL;
fbMasterAutoCycle.bPlateSenR := GVL_App.bPlateSenR;
GVL_HMI.bPlateSenL := GVL_App.bPlateSenL;
GVL_HMI.bPlateSenR := GVL_App.bPlateSenR;

(* ==========================================
   ROBOT COMMAND CONSUMPTION (nRobotCmd, written by fbRobotTcp on each
   CMD:<n> reply -- see the fbRobotTcp call further down).

   Consumed as a LEVEL and CLEARED here. The PLC clearing the field is the
   acknowledgement; the robot zeroing it after the next state push is now
   belt-and-braces rather than load-bearing.

   This used to be a pair of R_TRIGs on nRobotCmd = 1 / = 2, and nothing on
   the PLC side ever reset the field. That deadlocked the machine
   (2026-07-28, found on the real machine): a CMD:1 arriving while the panel
   was in Manual or latched in ERR fired the edge, the FB's IDLE branch
   correctly refused it, and nRobotCmd stayed at 1 forever. The robot
   re-asserts CMD:1 in every STATE reply until it sees the panel leave IDLE
   -- but re-sending a value that is already 1 produces no rising edge. So
   the robot waited for a state change while the PLC waited for an edge that
   could never come, and the Robot page showed CMD:1 arriving happily the
   whole time.

   Clearing makes it self-healing. A request that cannot be honoured this
   scan is dropped, and the robot's next keep-alive re-asserts it ~1 s
   later. Repeat pulses are harmless: only FB_MasterAutoCycle's IDLE branch
   consumes bExtStartPulse, and it is gated on bMachineAuto.

   Diagnostic note: nRobotCmd now reads 0 almost always, because it is
   consumed within a scan of arriving. The trace of a robot start is the
   'External start pulse' entry on the Logs page, and stRobot.sLastMessage
   still shows the raw CMD frame.

   RESET is fanned into the HMI bReset flag so operator- and robot-initiated
   resets share one consumption path inside the FB.
   ========================================== *)
bRobotStartPulse := FALSE;

IF GVL_Robot.stParams.nRobotCmd = 1 THEN
    bRobotStartPulse             := TRUE;
    GVL_Robot.stParams.nRobotCmd := 0;
ELSIF GVL_Robot.stParams.nRobotCmd = 2 THEN
    GVL_HMI.stMasterAuto.bReset  := TRUE;
    GVL_Robot.stParams.nRobotCmd := 0;
END_IF

fbMasterAutoCycle(
    bExtStartPulse := bRobotStartPulse,
    bMachineAuto   := GVL_HmiPersistent.stMasterAutoCfg.bAutoMode,
    stHmi          := GVL_HMI.stMasterAuto,
    stCfg          := GVL_HmiPersistent.stMasterAutoCfg,
    stRobot        := GVL_Robot.stRobot
);

(* Global Auto/Manual hard interlock. The machine-wide bAutoMode is the single
   source of truth for every piston's mode — driven unconditionally each scan
   onto BOTH eMode and bMode so a per-piston toggle cannot create a second
   control path (no double-control). FB_SolSpringPiston_2Pos edge-syncs
   bMode<->eMode, so forcing only one would let a stray toggle propagate for a
   scan; forcing both closes that gap. In Automatic the master cycle owns all
   six pistons; in Manual the operator jogs them and the cycle is held in IDLE. *)
bMachineAuto := GVL_HmiPersistent.stMasterAutoCfg.bAutoMode;
eMachineMode := SEL(bMachineAuto, E_ControlMode.Manual, E_ControlMode.Automatic);
GVL_HMI.stSepSol1.eMode  := eMachineMode;  GVL_HMI.stSepSol1.bMode  := bMachineAuto;
GVL_HMI.stPushSol1.eMode := eMachineMode;  GVL_HMI.stPushSol1.bMode := bMachineAuto;
GVL_HMI.stSepSol2.eMode  := eMachineMode;  GVL_HMI.stSepSol2.bMode  := bMachineAuto;
GVL_HMI.stPushSol2.eMode := eMachineMode;  GVL_HMI.stPushSol2.bMode := bMachineAuto;
GVL_HMI.stSepSol3.eMode  := eMachineMode;  GVL_HMI.stSepSol3.bMode  := bMachineAuto;
GVL_HMI.stPushSol3.eMode := eMachineMode;  GVL_HMI.stPushSol3.bMode := bMachineAuto;
GVL_HMI.stGripSolL.eMode := eMachineMode;  GVL_HMI.stGripSolL.bMode := bMachineAuto;
GVL_HMI.stGripSolR.eMode := eMachineMode;  GVL_HMI.stGripSolR.bMode := bMachineAuto;

(* ==========================================
   Panel push buttons.
   * LED outputs mirror the raw PB press state (wiring diagnostic).
   * PB1 in Auto mode: rising edge triggers a cycle-start bypass of the
     robot's CMD:1 -- feed into the master cycle's own sim-start flag which
     it OR-merges with the external start pulse.
   * PB1/2/3 in Manual mode: hold to jog corresponding piston group. The
     jog itself is passed through the piston FB's bJogExtend input below.
   ========================================== *)
GVL_App.bLedPb1 := GVL_App.bPb1;
GVL_App.bLedPb2 := GVL_App.bPb2;
GVL_App.bLedPb3 := GVL_App.bPb3;

(* ==========================================
   Machine status lamps (DO 12 green / DO 13 red).
   Unlike the PB LEDs above, which are dumb press mirrors, these report
   machine state:

     RED   = the master cycle is in its latched ERR state.
     GREEN = Auto and IDLE        -> steady  (armed, waiting for a start)
             Auto and cycling     -> blink   (running)
             Manual, or in ERR    -> off

   Green is off in ERR so the two lamps never contradict each other: red on
   with green also lit would read as "faulted but running". Green is off in
   Manual because it means "the automatic cycle is live", which is precisely
   what Manual is not.

   Blink source is a self-resetting TON toggling bBlink, giving 400 ms on /
   400 ms off. Using tonBlink.Q directly would light the lamp for a single
   scan per period -- invisible.
   ========================================== *)
tonBlink(IN := NOT tonBlink.Q, PT := T#400MS);
IF tonBlink.Q THEN
    bBlink := NOT bBlink;
END_IF

GVL_App.bLedRed := (GVL_HMI.stMasterAuto.eStep = E_MasterAutoStep.ERR);

IF NOT bMachineAuto OR GVL_HMI.stMasterAuto.eStep = E_MasterAutoStep.ERR THEN
    GVL_App.bLedGreen := FALSE;
ELSIF GVL_HMI.stMasterAuto.eStep = E_MasterAutoStep.IDLE THEN
    GVL_App.bLedGreen := TRUE;
ELSE
    GVL_App.bLedGreen := bBlink;
END_IF

fbTrigPb1(CLK := GVL_App.bPb1);
IF bMachineAuto AND fbTrigPb1.Q THEN
    GVL_HMI.stMasterAuto.bSimStartAssembly := TRUE;
END_IF;

bManualMode := NOT bMachineAuto;

(* ==========================================
   Pin separators (SOL-Spring, 2 limit switches, single Extend coil).
   The master cycle is the only auto driver; in Manual the piston FB
   ignores bAutoCmd* and follows the operator's jog buttons instead.
   ========================================== *)
fbSepSol1(
    bAutoCmdExtend   := fbMasterAutoCycle.bSepCmdExtend[1],
    bAutoCmdRetract  := fbMasterAutoCycle.bSepCmdRetract[1],
    bJogExtend       := bManualMode AND GVL_App.bPb2,
    bSwitchExtended  := GVL_App.bSensorSepExtended1,
    bSwitchRetracted := GVL_App.bSensorSepRetracted1,
    stHmi            := GVL_HMI.stSepSol1,
    bOutSolenoid     => GVL_App.bValveSepExtend1
);

fbSepSol2(
    bAutoCmdExtend   := fbMasterAutoCycle.bSepCmdExtend[2],
    bAutoCmdRetract  := fbMasterAutoCycle.bSepCmdRetract[2],
    bJogExtend       := bManualMode AND GVL_App.bPb2,
    bSwitchExtended  := GVL_App.bSensorSepExtended2,
    bSwitchRetracted := GVL_App.bSensorSepRetracted2,
    stHmi            := GVL_HMI.stSepSol2,
    bOutSolenoid     => GVL_App.bValveSepExtend2
);

fbSepSol3(
    bAutoCmdExtend   := fbMasterAutoCycle.bSepCmdExtend[3],
    bAutoCmdRetract  := fbMasterAutoCycle.bSepCmdRetract[3],
    bJogExtend       := bManualMode AND GVL_App.bPb2,
    bSwitchExtended  := GVL_App.bSensorSepExtended3,
    bSwitchRetracted := GVL_App.bSensorSepRetracted3,
    stHmi            := GVL_HMI.stSepSol3,
    bOutSolenoid     => GVL_App.bValveSepExtend3
);

(* ==========================================
   Pin pushers
   ========================================== *)
fbPushSol1(
    bAutoCmdExtend   := fbMasterAutoCycle.bPushCmdExtend[1],
    bAutoCmdRetract  := fbMasterAutoCycle.bPushCmdRetract[1],
    bJogExtend       := bManualMode AND GVL_App.bPb3,
    bSwitchExtended  := GVL_App.bSensorPushExtended1,
    bSwitchRetracted := GVL_App.bSensorPushRetracted1,
    stHmi            := GVL_HMI.stPushSol1,
    bOutSolenoid     => GVL_App.bValvePushExtend1
);

fbPushSol2(
    bAutoCmdExtend   := fbMasterAutoCycle.bPushCmdExtend[2],
    bAutoCmdRetract  := fbMasterAutoCycle.bPushCmdRetract[2],
    bJogExtend       := bManualMode AND GVL_App.bPb3,
    bSwitchExtended  := GVL_App.bSensorPushExtended2,
    bSwitchRetracted := GVL_App.bSensorPushRetracted2,
    stHmi            := GVL_HMI.stPushSol2,
    bOutSolenoid     => GVL_App.bValvePushExtend2
);

fbPushSol3(
    bAutoCmdExtend   := fbMasterAutoCycle.bPushCmdExtend[3],
    bAutoCmdRetract  := fbMasterAutoCycle.bPushCmdRetract[3],
    bJogExtend       := bManualMode AND GVL_App.bPb3,
    bSwitchExtended  := GVL_App.bSensorPushExtended3,
    bSwitchRetracted := GVL_App.bSensorPushRetracted3,
    stHmi            := GVL_HMI.stPushSol3,
    bOutSolenoid     => GVL_App.bValvePushExtend3
);

(* ==========================================
   Grip pistons — side clamps (L=[1], R=[2]) that hold the plate placed
   by the robot for the duration of the Sep/Push cycle.
   ========================================== *)
fbGripSolL(
    bAutoCmdExtend   := fbMasterAutoCycle.bGripCmdExtend[1],
    bAutoCmdRetract  := fbMasterAutoCycle.bGripCmdRetract[1],
    bJogExtend       := bManualMode AND GVL_App.bPb1,
    bSwitchExtended  := GVL_App.bSensorGripExtendedL,
    bSwitchRetracted := GVL_App.bSensorGripRetractedL,
    stHmi            := GVL_HMI.stGripSolL,
    bOutSolenoid     => GVL_App.bValveGripExtendL
);

fbGripSolR(
    bAutoCmdExtend   := fbMasterAutoCycle.bGripCmdExtend[2],
    bAutoCmdRetract  := fbMasterAutoCycle.bGripCmdRetract[2],
    bJogExtend       := bManualMode AND GVL_App.bPb1,
    bSwitchExtended  := GVL_App.bSensorGripExtendedR,
    bSwitchRetracted := GVL_App.bSensorGripRetractedR,
    stHmi            := GVL_HMI.stGripSolR,
    bOutSolenoid     => GVL_App.bValveGripExtendR
);

(* ==========================================
   Robot TCP/IP client (TCP-only protocol, port 6001). Runs every scan;
   its internal state machine dials the robot server and auto-reconnects
   on drop. The former discrete-I/O handshake is retired -- start/reset
   commands arrive via CMD:<n> replies, PLC state pushes via STATE:<n>.

   Compute nStateOut immediately after the master cycle so any transition
   this scan is visible to the robot on the next STATE push. MANUAL(30)
   sentinel while bAutoMode=FALSE so the robot knows the panel is out of
   auto and won't issue CMD:1.
   ========================================== *)
IF NOT GVL_HmiPersistent.stMasterAutoCfg.bAutoMode THEN
    GVL_Robot.stParams.nStateOut := INT#30;   (* MANUAL *)
ELSE
    GVL_Robot.stParams.nStateOut := TO_INT(GVL_HMI.stMasterAuto.eStep);
END_IF

fbRobotTcp(
    bEnable     := GVL_Robot.bTcpEnable,
    sRemoteHost := GVL_Robot.sRobotHost,
    nRemotePort := GVL_Robot.nRobotPort,
    stRobot     := GVL_Robot.stRobot,
    stParams    := GVL_Robot.stParams
);

(* ==========================================
   Persistent config flush. Called LAST so it compares this scan's final
   values, and after section 0 so the cold-boot clears are part of its
   baseline rather than looking like an operator edit.
   Writes ~2 s after the operator stops editing; logs each flush to
   GVL_Log (visible on the Logs page) so a failing write is not silent.
   ========================================== *)
fbPersistentSave();

]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="3" Count="304" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>