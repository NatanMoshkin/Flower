<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="PRG_IoMap" Id="{d3ccb63a-105a-48ed-83cb-e0b3577518bb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_IoMap
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ReadInputs();
WriteOutputs();

]]></ST>
    </Implementation>
    <Action Name="ReadInputs" Id="{f82895bb-0ca3-4c7d-b548-b9f92e196159}">
      <Implementation>
        <ST><![CDATA[(* ==========================================
   READ INPUTS — copy raw GVL_IO.dIn[] channels into named GVL_App aliases.
   Each SOL-Spring actuator has both a Retracted and an Extended proximity
   switch (spring retracts, coil extends; both end positions get sensors).
   ========================================== *)
GVL_App.bSensorSepRetracted1  := GVL_IO.dIn[1];
GVL_App.bSensorSepExtended1   := GVL_IO.dIn[2];
GVL_App.bSensorSepRetracted2  := GVL_IO.dIn[3];
GVL_App.bSensorSepExtended2   := GVL_IO.dIn[4];
GVL_App.bSensorSepRetracted3  := GVL_IO.dIn[5];
GVL_App.bSensorSepExtended3   := GVL_IO.dIn[6];
GVL_App.bSensorPushRetracted1 := GVL_IO.dIn[7];
GVL_App.bSensorPushExtended1  := GVL_IO.dIn[8];
GVL_App.bSensorPushRetracted2 := GVL_IO.dIn[9];
GVL_App.bSensorPushExtended2  := GVL_IO.dIn[10];
GVL_App.bSensorPushRetracted3 := GVL_IO.dIn[11];
GVL_App.bSensorPushExtended3  := GVL_IO.dIn[12];

(* Panel push buttons Consumer logic lives in MAIN (mode-gated
   jog OR cycle-start bypass). *)
GVL_App.bPb1 := GVL_IO.dIn[13];
GVL_App.bPb2 := GVL_IO.dIn[14];
GVL_App.bPb3 := GVL_IO.dIn[15];

(* Grip pistons  *)
GVL_App.bSensorGripRetractedL := GVL_IO.dIn[17];
GVL_App.bSensorGripExtendedL  := GVL_IO.dIn[18];
GVL_App.bSensorGripRetractedR := GVL_IO.dIn[19];
GVL_App.bSensorGripExtendedR  := GVL_IO.dIn[20];

(* Plate-presence sensors —Both must be TRUE for WAIT_PLATE to
   advance the cycle into GRIP_EXTENDING. *)
GVL_App.bPlateSenL := GVL_IO.dIn[21];
GVL_App.bPlateSenR := GVL_IO.dIn[22];

]]></ST>
      </Implementation>
    </Action>
    <Action Name="WriteOutputs" Id="{d4911134-0871-485c-a76f-89221ed9b4ed}">
      <Implementation>
        <ST><![CDATA[(* ==========================================
   WRITE OUTPUTS — copy named GVL_App aliases into raw GVL_IO.dOut[] channels.
   Single Extend coil per actuator (SOL-Spring, spring retracts).
   ========================================== *)
GVL_IO.dOut[1] := GVL_App.bValveSepExtend1;
GVL_IO.dOut[2] := GVL_App.bValveSepExtend2;
GVL_IO.dOut[3] := GVL_App.bValveSepExtend3;
GVL_IO.dOut[4] := GVL_App.bValvePushExtend1;
GVL_IO.dOut[5] := GVL_App.bValvePushExtend2;
GVL_IO.dOut[6] := GVL_App.bValvePushExtend3;

(* Panel push-button status LEDs — mirror driven by MAIN. *)
GVL_IO.dOut[7] := GVL_App.bLedPb1;
GVL_IO.dOut[8] := GVL_App.bLedPb2;
GVL_IO.dOut[9] := GVL_App.bLedPb3;

(* Grip piston extend coils. *)
GVL_IO.dOut[10] := GVL_App.bValveGripExtendL;
GVL_IO.dOut[11] := GVL_App.bValveGripExtendR;

(* Machine status lamps. Green = Auto idle steady / cycling blink;
   red = master cycle in ERR. Both driven by MAIN. *)
GVL_IO.dOut[12] := GVL_App.bLedGreen;
GVL_IO.dOut[13] := GVL_App.bLedRed;

]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="PRG_IoMap">
      <LineId Id="3" Count="2" />
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="PRG_IoMap.ReadInputs">
      <LineId Id="2" Count="3" />
      <LineId Id="22" Count="12" />
      <LineId Id="51" Count="4" />
      <LineId Id="35" Count="0" />
      <LineId Id="56" Count="0" />
      <LineId Id="36" Count="10" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="PRG_IoMap.WriteOutputs">
      <LineId Id="2" Count="2" />
      <LineId Id="15" Count="6" />
      <LineId Id="26" Count="4" />
      <LineId Id="35" Count="0" />
      <LineId Id="32" Count="2" />
      <LineId Id="31" Count="0" />
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>