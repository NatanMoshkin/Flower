<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HmiMasterAutoCfg" Id="{82e16909-a8ed-4355-8491-bced6b308e5c}">
    <Declaration><![CDATA[TYPE ST_HmiMasterAutoCfg :
STRUCT
    // Timers, milliseconds. UDINT so HMI NumericInput binds directly.
    tDwellPushMs            : UDINT := 2000;   // DWELL_PUSH -- hold at push-extended
    tPushRetractedDwellMs   : UDINT := 500;    // PUSH_RETRACTED_DWELL -- hold after push retract
    tSepRetractedDwellMs    : UDINT := 500;    // SEP_RETRACTED_DWELL -- hold after sep retract before IDLE

    // Timeout guards every non-DWELL waiting state. On expiry, iErrorCode is
    // set to the step's numeric code and the cycle enters ERR.
    tStepTimeoutMs          : UDINT := 10000;

    // Dedicated timeout for CHECK_PLATE (bounded by robot placement time, not
    // by a motion budget). On expiry, iErrorCode := 9 and the cycle enters ERR
    // — unless bBypassPlateSensors is set, see below.
    tPlateWaitTimeoutMs     : UDINT := 10000;

    // Panel push-button HOLD durations, milliseconds. Both are deliberate
    // two-hand / sustained gestures rather than edges, so a knock or a brushed
    // sleeve cannot trigger them.
    //
    // tPbStopHoldMs  — how long the RED PB1 must be held in Automatic to STOP
    //                  the machine (disarm to NOT_HOMED).
    // tPbStartHoldMs — how long the GREEN PB3 and ORANGE PB2 must be held
    //                  TOGETHER to start one bulb cycle from IDLE, which is the
    //                  operator's parallel to the robot's CMD:1.
    //
    // Editable on AutoMain so the duration can be tuned to the operators
    // without a rebuild.
    tPbStopHoldMs           : UDINT := 1000;
    tPbStartHoldMs          : UDINT := 1000;

    // If TRUE, the 4 movement states ignore sensor feedback and advance when
    // tStepTimeoutMs expires — the timeout doubles as the fixed step duration.
    // No timeout-error path while sensorless. Mirrors ST_HmiPistonAutoCfg.bNoSensors.
    // Deliberately does NOT cover WAIT_PLATE — use bBypassPlateSensors for that.
    bNoSensors              : BOOL  := FALSE;

    // Plate-sensor bypass. Removes only the WAIT_PLATE timeout ERROR, not the
    // wait itself: the bPlateSenL AND bPlateSenR fast-path still advances the
    // cycle as normal, so with healthy sensors nothing changes. With unwired
    // or faulty ones, tPlateWaitTimeoutMs degrades into a fixed placement
    // dwell and the cycle continues instead of raising error 9.
    // Separate from bNoSensors on purpose: skipping the plate gate is a
    // safety-relevant decision and should be made explicitly, not inherited
    // from a bench-testing flag.
    bBypassPlateSensors     : BOOL  := FALSE;

    // While TRUE, IDLE immediately starts the next cycle (no START or
    // robot CMD:1 edge needed). Uncheck to stop after the cycle returns
    // to IDLE. Cleared by the FB on entry to ERR so a RESET does not
    // instantly restart motion.
    bContinuous             : BOOL  := FALSE;

    // Global machine mode — single source of truth for every piston's mode.
    // BOOL so the classic VISU HMI (boolean-only) binds a checkbox directly,
    // matching the per-piston bMode convention. FALSE = Manual (operator jogs
    // each piston; master cycle held in IDLE). TRUE = Automatic (MasterAutoCycle
    // owns all six pistons). Enforced every scan in MAIN onto each piston's
    // eMode AND bMode, so there is no per-piston double-control.
    bAutoMode               : BOOL := FALSE;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
