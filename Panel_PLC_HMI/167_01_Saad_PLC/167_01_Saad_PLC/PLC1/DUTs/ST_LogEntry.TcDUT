<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_LogEntry" Id="{b5d2e891-cba4-4d5a-ae24-4a96cbe70dde}">
    <Declaration><![CDATA[TYPE ST_LogEntry :
STRUCT
    // Wall-clock HH:MM:SS, stamped by F_LogEvent from GVL_Log.sNow (which
    // MAIN refreshes once a second from FB_LocalSystemTime). Added 2026-07-27
    // for the panel's Logs page, which has no drainer to stamp entries for it.
    //
    // This struct used to carry no timestamp on the reasoning that "Python
    // assigns wall-clock time when it drains the ring" — true, but that only
    // ever covered FlowerPyHmi. FlowerPyHmi still stamps its own arrival time
    // and ignores this field; the two do not have to agree, and sTime is the
    // more accurate of the two since it is taken at the moment of the event
    // rather than up to plc_ring_poll_ms later.
    //
    // Second resolution only. If sub-second ordering ever matters, add
    // nTick : UDINT rather than widening this string.
    sTime   : STRING(8);


    eSev    : E_LogSev;

    // Display mirror of eSev, set by F_LogEvent. Exists because the classic
    // VISU text output cannot resolve an enum to its enumerator name --
    // {attribute 'to_string'} only enables TO_STRING() in ST, it does not
    // teach the visualization anything. Same reason ST_HmiMasterAuto carries
    // sStepText next to eStep. FlowerPyHmi ignores this field; it renders
    // from eSev via its own SEV_NAMES map.
    // STRING(8), not STRING(4): the four current names top out at 4 chars,
    // but an exactly-sized string would silently truncate a longer one.
    sSevText : STRING(8);

    sSource : STRING(20);    // short instance name, e.g. 'SepSol1Auto'
    sMsg    : STRING(80);    // human-readable message
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
