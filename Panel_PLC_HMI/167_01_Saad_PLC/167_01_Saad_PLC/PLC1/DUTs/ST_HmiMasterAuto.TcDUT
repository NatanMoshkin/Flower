<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HmiMasterAuto" Id="{d8256873-a04f-4e94-90b4-5238eec564a2}">
    <Declaration><![CDATA[TYPE ST_HmiMasterAuto :
STRUCT
    // Display label ('MasterAuto'). Set from GVL_HMI init, never written by FB.
    Name             : STRING(30);

    // HMI writes -- momentary command buttons (R_TRIG inside FB latches the
    // rising edge). NOTE bStart means "home the pistons and arm", NOT "run a
    // bulb cycle" -- only the robot's CMD:1 starts a cycle. Also driven by the
    // green PB3 in Automatic (see MAIN).
    bStart           : BOOL;
    (* Operator "run ONE bulb from IDLE" -- the HMI parallel to holding the
       orange PB2 + green PB3 combo, and to the robot's CMD:1. Momentary:
       FB_MasterAutoCycle detects the rising edge and clears it.

       Deliberately a SEPARATE field from bStart. bStart means "home and
       arm" and is accepted in NOT_HOMED only; making it also mean "run a
       bulb" in IDLE would give one symbol two meanings that differ by
       state, which is exactly the shape that let a green-before-orange
       combo press silently lose its bulb request (fixed 2026-08-05 by
       removing START from IDLE -- do not put it back).

       Also separate from bSimStartAssembly, which is the documented BENCH
       stand-in for the robot. Two fields keep "an operator started a bulb"
       and "someone simulated the robot" distinguishable in the log ring. *)
    bStartCycle      : BOOL;
    bStop            : BOOL;
    bReset           : BOOL;

    // FB writes -- status.
    //
    // Defaults to NOT_HOMED, and that default is what keeps the machine still
    // after a power cycle: GVL_HMI is plain VAR_GLOBAL, so this initialiser is
    // re-applied on every cold boot and every download. bAutoMode persists, so
    // without it the panel would come back in Automatic reporting IDLE(0) and a
    // running robot could command a cycle with the pistons anywhere.
    eStep            : E_MasterAutoStep := E_MasterAutoStep.NOT_HOMED;
    sStepText        : STRING(20);   // human-readable mirror of eStep
    tElapsedS        : LREAL;        // seconds spent in the current step (0.0 on transition)
    iErrorCode       : INT;          // 0 = OK; see FB_MasterAutoCycle header for the code table
    sErrorText       : STRING(80);
    nCyclesCompleted : UDINT;        // incremented at end of GRIP_RETRACTING

    // HMI writes -- bench sim of the robot's start command. Rising edge inside
    // the FB behaves the same as an incoming CMD:1 pulse (see bExtStartPulse).
    // FB auto-clears this flag after the rising edge is consumed.
    bSimStartAssembly      : BOOL;

    // HMI writes -- per-step Simulate flags. Rising edge shortcuts the current
    // step's wait condition (FB clears the flag on consumption via R_TRIG.Q).
    bSimStep_Idle          : BOOL;
    bSimStep_InitPushRet   : BOOL;
    bSimStep_InitSepRet    : BOOL;
    bSimStep_InitGripRet   : BOOL;
    bSimStep_WaitPlate     : BOOL;
    bSimStep_GripExt       : BOOL;
    bSimStep_SepExt        : BOOL;
    bSimStep_WaitPos2      : BOOL;
    bSimStep_PushExt       : BOOL;
    bSimStep_DwellPush     : BOOL;
    bSimStep_PushRet       : BOOL;
    bSimStep_PushRetDwell  : BOOL;
    bSimStep_SepRet        : BOOL;
    bSimStep_SepRetDwell   : BOOL;
    bSimStep_GripRet       : BOOL;
    (* The RECOVER chain wants sim flags for the same reason the INIT chain
       has them: all three are sensor-waiting states, so without these a
       recovery cannot be stepped on a bench whose sensors are not wired.
       Added 2026-08-05; the RECOVER states themselves shipped without them. *)
    bSimStep_RecoverPushRet : BOOL;
    bSimStep_RecoverSepRet  : BOOL;
    bSimStep_RecoverGripRet : BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
