<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="E_MasterAutoStep" Id="{c2182ce0-28f7-4200-922e-51cf0341525c}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_MasterAutoStep :
(
    IDLE                 := 0,
    SEP_EXTENDING        := 1,
    WAIT_POS2            := 2,
    PUSH_EXTENDING       := 3,
    DWELL_PUSH           := 4,
    PUSH_RETRACTING      := 5,
    PUSH_RETRACTED_DWELL := 6,
    SEP_RETRACTING       := 7,
    SEP_RETRACTED_DWELL  := 8,
    INIT_PUSH_RETRACTING := 10,
    INIT_SEP_RETRACTING  := 11,
    INIT_GRIP_RETRACTING := 12,
    // Renamed from WAIT_PLATE 2026-08-05. Wire value 20 is UNCHANGED, so the
    // robot cannot tell the difference; only the panel text and the source read
    // differently. It does more than wait -- it is the plate-presence gate.
    CHECK_PLATE          := 20,
    GRIP_EXTENDING       := 21,
    GRIP_RETRACTING      := 22,
    MANUAL               := 30,
    // In Automatic but NOT armed: the pistons have not been homed under
    // operator control since power-up / Manual / a STOP, so the robot must not
    // command a cycle. Exited only by an operator START (HMI button or PB3),
    // which runs the INIT retract chain and lands in IDLE.
    //
    // 40 sits in the same "not a sequence step" class as MANUAL(30) and
    // ERR(99). Values are WIRE values -- nStateOut is read by the robot -- so
    // nothing here may ever be renumbered.
    //
    // Keep the name short: sStepText is STRING(20) and INIT_PUSH_RETRACTING
    // already fills it exactly, so a longer enumerator would truncate.
    NOT_HOMED            := 40,

    // Fault-recovery retract chain, added 2026-08-05. Same MOTION as the
    // RETRACT/INIT chain (push, then sep, then grip -- the collision ordering)
    // but its own identity, so a failed recovery is distinguishable from a
    // failed arming: distinct sStepText, distinct error codes 12/13/14, and a
    // distinct value on the wire.
    //
    // Entered only from ERR on RESET; exits to IDLE (armed). 50/51/52 rather
    // than 13/14/15 because a fresh decade matches the convention that
    // non-bulb-cycle states own decades (30 Manual, 40 Not-homed, 99 Err), and
    // STATE:5x is instantly greppable in a robot log. Adjacency to 10/11/12
    // would invite exactly the confusion these states exist to remove.
    //
    // The robot needs NO new branch: it acts on 0 (armed), 99 (faulted) and
    // treats everything else as "wait", which is correct for all three.
    //
    // Names are <= 20 chars because sStepText is STRING(20).
    RECOVER_PUSH_RETR    := 50,
    RECOVER_SEP_RETR     := 51,
    RECOVER_GRIP_RETR    := 52,

    ERR                  := 99
) ;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
