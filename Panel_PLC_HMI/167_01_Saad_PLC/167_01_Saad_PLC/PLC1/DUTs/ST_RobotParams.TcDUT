<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_RobotParams" Id="{48e0cfb9-5ce6-4b32-9c93-d402e6dcbe42}">
    <Declaration><![CDATA[TYPE ST_RobotParams :
STRUCT
    // ------------------------------------------------------------------
    // Dobot tuning parameters exchanged over TCP:6001. TCP is now the ONLY
    // robot channel -- start/stop moved from discrete I/O to STATE:n / CMD:n
    // frames (see nStateOut / nRobotCmd below). Field names and order match
    // the robot's SYNC string (global.lua / dummy_server.py). Defaults
    // mirror the dummy server.
    //
    // UNITS AND RANGES. The four speeds are PERCENTAGES, not absolute
    // velocities: global.lua Init() passes J_SPEED / L_SPEED to VelJ() /
    // VelL(), and WAX_SPEED / WATER_SPEED feed the v= velocity-ratio option
    // of MovL. A global SpeedFactor(80) scales everything on top. The waits
    // are milliseconds. INT is an encoding detail, not a statement of range.
    //
    // Ranges below are the vendor's own -- the Dobot tuning GUI
    // (Robot\167-01-Saad\tcp client.py) clamps to them, and readme.txt
    // mirrors the table. The robot's Lua does NOT validate (src2.lua assigns
    // tonumber() straight through), so FB_RobotTcpClient.ClampParam enforces
    // them for every writer. The panel's NumericInputs also carry matching
    // InputBoxMin/Max, but per-control limits only bound their own control.
    // ------------------------------------------------------------------
    J_SPEED            : INT := 10;     //    1..100  %
    L_SPEED            : INT := 10;     //    1..100  %
    REPEATS            : INT := 2;      //    1..10
    START_WAIT         : INT := 500;    //   10..10000 ms
    WATER_WAIT         : INT := 500;    //   10..10000 ms
    STAND_WAIT         : INT := 2000;   //   10..10000 ms
    END_WAIT           : INT := 500;    //   10..10000 ms
    WATER_SPEED        : INT := 10;     //    0..100  %
    WAX_WAIT_TIME_IN   : INT := 500;    //    0..10000 ms
    WAX_WAIT_TIME_OUT  : INT := 500;    //   10..10000 ms
    WAX_SPEED          : INT := 10;     //    0..100  %

    // ------------------------------------------------------------------
    // Request flags -- FB_RobotTcpClient consumes each on the next idle
    // scan while Connected, sends the matching message, then auto-clears
    // the flag once the reply is received. Rising-level, not edge: setting
    // TRUE from the HMI is enough.
    // ------------------------------------------------------------------

    // Send GET_SYNC; the SYNC reply is parsed back into the 11 fields above.
    // The FB also raises this itself once, right after each (re)connect.
    bGetSync           : BOOL;

    // Raw escape hatch: send "sSetName:nSetVal" (e.g. "J_SPEED:15"); robot
    // replies "OK: SET NAME". NOT needed for the 11 params above -- writing
    // one of those fields directly (from the HMI or ST) is detected by
    // FB_RobotTcpClient's shadow-copy comparison and pushed automatically.
    // Use this only for names that are not fields of this struct.
    bSetParam          : BOOL;
    sSetName           : STRING(30);
    nSetVal            : INT;

    // Send "New_Bulb:1"; robot replies "OK: SET New_Bulb" and starts a fresh bulb.
    bTriggerNewBulb    : BOOL;

    // ------------------------------------------------------------------
    // State + command channel (replaces the retired discrete-I/O handshake).
    //
    // nStateOut : INT -- MAIN writes each scan. Value is TO_INT(eStep) in
    //   Automatic mode, or E_MasterAutoStep.MANUAL (30) when bAutoMode=FALSE.
    //   FB_RobotTcpClient sends "STATE:n" on change and every STATE_IDLE_MS
    //   as keep-alive.
    //
    // nRobotCmd : INT -- FB_RobotTcpClient writes each time a "CMD:n" reply
    //   arrives. MAIN R_TRIGs on nRobotCmd=1 (start cycle) and =2 (reset
    //   error). Robot is responsible for zeroing after the PLC's next state
    //   push acknowledges the command.
    // ------------------------------------------------------------------
    nStateOut          : INT;
    nRobotCmd          : INT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
