<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HmiRobot" Id="{527dd88d-da12-40b1-8b68-95016637935a}">
    <Declaration><![CDATA[TYPE ST_HmiRobot :
STRUCT
    // Display label ('Robot'). Set from GVL_Robot, never written by bridge.
    Name           : STRING(30);

    // ------------------------------------------------------------------
    // Robot comms are now TCP-only. Start/reset commands come from the
    // robot as CMD:n replies (see ST_RobotParams.nRobotCmd); PLC state is
    // pushed to the robot as STATE:n (see ST_RobotParams.nStateOut). The
    // former discrete-I/O handshake (bStartAssembly/bAssemblyRunning wired
    // to STAND_SEQ_DO/STAND_SEQ_DI) is retired -- DI[13] and DO[7] are now
    // free channels.
    //
    // Fields below are the TCP status mirror written by FB_RobotTcpClient
    // and read by the HMI.
    // ------------------------------------------------------------------
    eConnState     : E_RobotConnState;
    sConnStateText : STRING(20);
    nPacketsRx     : UDINT;
    nPacketsTx     : UDINT;
    sLastMessage   : STRING(80);
    sLastTxMessage : STRING(80);

    // The deprecated POS/AUTO_STARTED fields (bAtPos1/2/3, bTxAutoStarted,
    // bTxPushDone, bTxPistonsError, bRxResetError) were deleted 2026-07-26.
    // They existed only for legacy Flower_HMI page bindings on the retired
    // TCP POS protocol; that project is gone, no PLC code touched them, and
    // FlowerPyHmi does not poll them (scripts/check_pyhmi_contract.py).
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
