<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_App" Id="{f7ee3213-c403-4290-aff3-682ca99b3920}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// Cooked IO aliases. Bound to the raw GVL_IO.dIn[i]/dOut[i] hardware arrays
// in MAIN's read-inputs / write-outputs bookends. No AT %*: these are plain
// BOOLs the FBs consume — the actual hardware wiring lives in GVL_IO.
//
// Tag convention: <Device>Sol<N>  = single EXTEND coil (SOL-Spring).
// The mechanical spring returns the actuator when the coil is de-energised,
// so no per-actuator Retract alias exists. DI still has a Retracted sensor.
//
//   SepSolN : Pin separator N   (DI 1..6, DO 1..3)
//   PushSolN: Pin push N        (DI 7..12, DO 4..6)
//   PbN / LedPbN: panel push buttons + status LEDs (DI 13..15, DO 7..9).
//                Behavior mode-gated -- see field comments below.
//   GripSolL / GripSolR: side grip pistons that clamp the robot-placed plate
//                       (DI 17..20, DO 10..11)
//   PlateSenL / PlateSenR: plate-presence sensors gating cycle start
//                         (DI 21..22)
//
// DI layout (rewired 2026-07-27 to match the physical terminals):
//   dIn[1..6]   = SepSol1..3 (Retract, Extend)
//   dIn[7..12]  = PushSol1..3 (Retract, Extend)
//   dIn[13..15] = PB1/2/3
//   dIn[16]     = free -- spare channel closing out the second 8-ch terminal,
//                 so the grip sensors start on a terminal boundary
//   dIn[17..18] = GripSolL (Retract, Extend)
//   dIn[19..20] = GripSolR (Retract, Extend)
//   dIn[21..22] = PlateSenL / PlateSenR
//   dIn[23..24] = free
//
// DO layout:
//   dOut[1..3]   = SepSolN Extend
//   dOut[4..6]   = PushSolN Extend
//   dOut[7..9]   = PB1/2/3 LEDs
//   dOut[10..11] = GripSolL/R Extend
//   dOut[12]     = LED_GREEN (machine status)
//   dOut[13]     = LED_RED (machine status)
//   dOut[14..16] = free
VAR_GLOBAL
    // SepSol1 (Pin separator 1) — DI 1..2, DO 1
    bSensorSepRetracted1  : BOOL;
    bSensorSepExtended1   : BOOL;
    bValveSepExtend1      : BOOL;

    // SepSol2 (Pin separator 2) — DI 3..4, DO 2
    bSensorSepRetracted2  : BOOL;
    bSensorSepExtended2   : BOOL;
    bValveSepExtend2      : BOOL;

    // SepSol3 (Pin separator 3) — DI 5..6, DO 3
    bSensorSepRetracted3  : BOOL;
    bSensorSepExtended3   : BOOL;
    bValveSepExtend3      : BOOL;

    // PushSol1 (Pin push 1) — DI 7..8, DO 4
    bSensorPushRetracted1 : BOOL;
    bSensorPushExtended1  : BOOL;
    bValvePushExtend1     : BOOL;

    // PushSol2 (Pin push 2) — DI 9..10, DO 5
    bSensorPushRetracted2 : BOOL;
    bSensorPushExtended2  : BOOL;
    bValvePushExtend2     : BOOL;

    // PushSol3 (Pin push 3) — DI 11..12, DO 6
    bSensorPushRetracted3 : BOOL;
    bSensorPushExtended3  : BOOL;
    bValvePushExtend3     : BOOL;

    // GripSolL (side grip, left) — DI 17..18, DO 10
    bSensorGripRetractedL : BOOL;
    bSensorGripExtendedL  : BOOL;
    bValveGripExtendL     : BOOL;

    // GripSolR (side grip, right) — DI 19..20, DO 11
    bSensorGripRetractedR : BOOL;
    bSensorGripExtendedR  : BOOL;
    bValveGripExtendR     : BOOL;

    // Plate-presence sensors — DI 21..22 (input only; no coil)
    bPlateSenL : BOOL;
    bPlateSenR : BOOL;

    // Panel push buttons + status LEDs — DI 13..15 / DO 7..9.
    // PB1 in Auto  = cycle-start bypass (bypass of robot's CMD:1).
    // PB1 in Manual = hold to extend both grip pistons.
    // PB2 in Manual = hold to extend all 3 SepSol pistons.
    // PB3 in Manual = hold to extend all 3 PushSol pistons.
    // LEDs mirror the corresponding PB press state (wiring diagnostic).
    bPb1     : BOOL;
    bPb2     : BOOL;
    bPb3     : BOOL;

    // Machine status lamps -- DO 12 / DO 13. Driven by MAIN from the master
    // cycle's state, NOT press mirrors like the PB LEDs above.
    //   bLedRed   = master cycle latched in ERR.
    //   bLedGreen = Auto+IDLE steady, Auto+cycling blink, otherwise off.
    bLedGreen : BOOL;
    bLedRed   : BOOL;
    bLedPb1  : BOOL;
    bLedPb2  : BOOL;
    bLedPb3  : BOOL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
