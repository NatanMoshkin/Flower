<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_HmiPersistent" Id="{b07a24e8-6d3b-41c2-8231-18ba1665c737}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'TcHmiSymbol.AddSymbol'}
VAR_GLOBAL PERSISTENT
    // Auto-cycle configuration. PERSISTENT so operator-tuned dwell / timeout
    // values survive an Activate Configuration + PLC restart. Values reset
    // to the struct defaults only on a full cold-boot reset.
    stSepSol1AutoCfg  : ST_HmiPistonAutoCfg;
    stSepSol2AutoCfg  : ST_HmiPistonAutoCfg;
    stSepSol3AutoCfg  : ST_HmiPistonAutoCfg;
    stPushSol1AutoCfg : ST_HmiPistonAutoCfg;
    stPushSol2AutoCfg : ST_HmiPistonAutoCfg;
    stPushSol3AutoCfg : ST_HmiPistonAutoCfg;
    stGripSolLAutoCfg : ST_HmiPistonAutoCfg;
    stGripSolRAutoCfg : ST_HmiPistonAutoCfg;

    // Config for the master (multi-piston + robot-coordinated) auto sequence.
    // See ST_HmiMasterAutoCfg for the tunable list; defaults land on cold-boot.
    stMasterAutoCfg   : ST_HmiMasterAutoCfg;

    // Durable CSV log config -- Phase 1 of docs/plans/log-csv-file.md.
    // Default bEnabled = FALSE, so adding this changes no behaviour until an
    // operator turns it on. FB_PersistentAutoSave watches it explicitly; a
    // field added here is NOT flushed until it is in that FB's shadow compare.
    //
    // ADDING A FIELD TO THIS GVL CHANGES THE PERSISTENT LAYOUT, which can
    // invalidate the existing Port_851.bootdata. After the first download,
    // check that the operator's timers still hold their values -- if they have
    // fallen back to declared defaults, re-enter them once. Verified before this
    // change that the values WERE surviving (tStepTimeoutMs read 1000, not its
    // declared 10000), so a reset afterwards is attributable to this edit.
    stLogFileCfg      : ST_HmiLogFileCfg;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
