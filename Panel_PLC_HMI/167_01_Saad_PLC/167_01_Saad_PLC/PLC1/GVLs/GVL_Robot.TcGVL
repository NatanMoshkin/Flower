<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Robot" Id="{2f2957ad-9ce7-4061-8c32-dda5963bc0f5}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'TcHmiSymbol.AddSymbol'}
VAR_GLOBAL
    stRobot : ST_HmiRobot := (Name := 'Robot');

    // Robot tuning parameters, request flags, and the STATE/CMD channel --
    // all exchanged over TCP:6001 by FB_RobotTcpClient, which is the SOLE
    // robot channel (the discrete-I/O handshake was retired 2026-07-26).
    // The 11 tuning params are read/write: editing one here is detected by
    // the FB's shadow-copy comparison and pushed to the robot.
    stParams : ST_RobotParams;

    // Master enable for the TCP client. FALSE holds it disconnected.
    // Deliberately NOT persistent: a link disabled for a bench session
    // should come back enabled after a power cycle rather than leaving the
    // robot silently unreachable with no obvious reason why.
    bTcpEnable : BOOL := TRUE;
END_VAR

VAR_GLOBAL PERSISTENT
    // TCP client target. PLC dials the robot's server. Host is set by the
    // commissioner (robot IP); port matches global.lua.
    //
    // PERSISTENT because the correct value DIFFERS BETWEEN INSTALLATIONS --
    // that, not "does it reset on boot", is the test for whether something
    // is configuration. As plain VAR_GLOBAL these were re-applied from the
    // literals below on every Activate Configuration, download and reset,
    // silently discarding whatever the commissioner had typed on the Robot
    // page. Nothing reported an error: the write succeeded, the field really
    // did change, and it really was reverted later.
    //
    // The declared values are the FACTORY DEFAULT, applied only on a
    // first-ever boot or Reset Origin. FB_PersistentAutoSave flushes edits
    // to disk ~2 s after the operator stops typing.
    //
    // Declared here rather than in GVL_HmiPersistent so the symbol paths
    // GVL_Robot.sRobotHost / .nRobotPort are unchanged -- a GVL may hold
    // both a volatile and a persistent block.
    sRobotHost : STRING := '192.168.201.1';
    nRobotPort : UINT := 6001;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
