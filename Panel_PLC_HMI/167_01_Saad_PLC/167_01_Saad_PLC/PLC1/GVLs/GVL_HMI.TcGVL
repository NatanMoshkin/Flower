<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_HMI" Id="{84707bcf-3378-4833-8d7b-1dd8328a77ca}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'TcHmiSymbol.AddSymbol'}
VAR_GLOBAL
    stSepSol1  : ST_HmiPiston := (Name := 'SepSol1');
    stSepSol2  : ST_HmiPiston := (Name := 'SepSol2');
    stSepSol3  : ST_HmiPiston := (Name := 'SepSol3');
    stPushSol1 : ST_HmiPiston := (Name := 'PushSol1');
    stPushSol2 : ST_HmiPiston := (Name := 'PushSol2');
    stPushSol3 : ST_HmiPiston := (Name := 'PushSol3');
    stGripSolL : ST_HmiPiston := (Name := 'GripSolL');
    stGripSolR : ST_HmiPiston := (Name := 'GripSolR');

    // Runtime state for the per-piston auto sequencers. Config for each
    // lives in the matching stXxxAutoCfg in GVL_HmiPersistent (PERSISTENT).
    // In this panel solution the master cycle is the sole auto driver;
    // these per-piston Auto structs exist so the HMI's UC_PistonAuto tiles
    // have something to bind to. Their bStart/bStop/bReset are effectively
    // no-ops in the 167_01 solution.
    stSepSol1Auto  : ST_HmiPistonAuto;
    stSepSol2Auto  : ST_HmiPistonAuto;
    stSepSol3Auto  : ST_HmiPistonAuto;
    stPushSol1Auto : ST_HmiPistonAuto;
    stPushSol2Auto : ST_HmiPistonAuto;
    stPushSol3Auto : ST_HmiPistonAuto;
    stGripSolLAuto : ST_HmiPistonAuto;
    stGripSolRAuto : ST_HmiPistonAuto;

    // Plate-presence sensors exposed to the HMI (indicator lamps on the
    // AutoCycle page). Mirror of GVL_App.bPlateSen* driven in MAIN.
    bPlateSenL : BOOL;
    bPlateSenR : BOOL;

    // Runtime state for the master (multi-piston + robot-coordinated) auto
    // sequence. Config for it lives in GVL_HmiPersistent.stMasterAutoCfg.
    stMasterAuto   : ST_HmiMasterAuto := (Name := 'MasterAuto');

    // Global machine mode — the single source of truth for every piston's mode.
    // FALSE = Manual (operator jogs each piston; the master cycle is held in
    // NOT_HOMED). TRUE = Automatic (FB_MasterAutoCycle owns all eight pistons).
    // MAIN enforces it every scan onto each piston's eMode AND bMode, so there
    // is no per-piston double-control -- "no option to double control".
    //
    // DELIBERATELY NOT PERSISTENT, and deliberately not in stMasterAutoCfg
    // (moved out of it 2026-08-06). This GVL is plain VAR_GLOBAL, so the
    // initialiser below is re-applied on every cold boot and every download:
    // the machine always comes up in Automatic, which is its normal condition,
    // rather than restoring whatever mode was last selected.
    //
    // Safe because arming is a separate axis: stMasterAuto.eStep defaults to
    // NOT_HOMED, which reports STATE:40 -- the robot reads that as "wait" -- so
    // nothing can move until an operator presses ENABLE AUTO. Booting Automatic
    // decides WHO may drive the pistons, not WHETHER they may move.
    //
    // Consequence worth knowing: a technician who selects Manual to jog a piston
    // and then power-cycles comes back in Automatic, where the PB jogs are off by
    // design. Re-select Manual after a reboot.
    // BOOL rather than E_ControlMode so the classic VISU binds a checkbox
    // directly, matching the per-piston bMode convention.
    bAutoMode      : BOOL := TRUE;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
