<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Log" Id="{364bb45e-a498-4daa-a47c-ed8ea18daa8b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'TcHmiSymbol.AddSymbol'}
VAR_GLOBAL
    // Ring buffer of the most recent log entries the PLC has produced.
    // The Python bridge polls nWriteIdx via ADS and drains new slots.
    //   write slot at any moment = (nWriteIdx MOD 256)
    //   overflow detected when (nWriteIdx - lastReadIdx) > 256
    aLog        : ARRAY[0..255] OF ST_LogEntry;

    // Monotonic write counter (never wraps in practice — UDINT overflows
    // after 2^32 writes ≈ 4.3 billion, decades even at 1 kHz logging).
    nWriteIdx   : UDINT;

    // Global mute for PLC-side logging. When FALSE, F_LogEvent early-returns
    // without writing to aLog or aRecent. HMI Logs page binds this.
    bLogEnabled : BOOL := TRUE;

    // Runtime toggle for DEBUG severity. F_LogEvent drops DBG entries
    // when this is FALSE. Operator can flip it from the HMI without a
    // rebuild. HMI ToggleSwitch on the Robot page binds here.
    bDebugMode  : BOOL := FALSE;

    // Newest-first mirror of the last 20 entries. F_LogEvent shifts the
    // slots down and writes aRecent[0] on every accepted call, so the HMI
    // Logs page can bind aRecent[0..19] directly in display order.
    // aRecent[0] is the newest entry.
    aRecent     : ARRAY[0..19] OF ST_LogEntry;

    // Wall-clock HH:MM:SS, refreshed once a second by MAIN from
    // FB_LocalSystemTime, and copied into every entry by F_LogEvent.
    // It lives here rather than inside F_LogEvent because a FUNCTION cannot
    // own the FB instance FB_LocalSystemTime needs — functions are stateless,
    // so the cyclic tick has to happen in a POU that has one.
    // Reads '--:--:--' until the time source reports valid, so a panel with
    // an unset RTC shows that plainly instead of a plausible wrong time.
    sNow        : STRING(8) := '--:--:--';

    // NOTE stBridgeCfg / ST_LogBridgeCfg used to live here and are GONE
    // (2026-08-07). The field existed solely so the retired
    // RobotBridge/log_pump.py could publish its own logger configuration for an
    // HMI to render. The bridge was retired 2026-07-26 and nothing wrote the
    // struct after that, so it read as empty strings and zeros and made a
    // shipped FlowerPyHmi page render a visibly blank block. Removed from
    // FlowerPyHmi first, then from here -- that order matters, because deleting
    // the symbol while the poller still asks for it makes read_many log
    // "dropping N unresolvable symbol(s)", which looks like a real fault.
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
